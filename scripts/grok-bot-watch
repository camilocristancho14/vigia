#!/usr/bin/env python3
"""Zero-config detector for Grok Bot agents working on this box.

Polls /proc for exec-daemon command shells (identified by the
CURSOR_CONVERSATION_ID environment variable) and the bots' own state files
under the agents directory, attributes each live conversation to a bot name
read from its profile.json, and calls vigia-grok (UserPromptSubmit on
idle->working, Stop after a quiet period on working->idle) so Vigía shows
who is working without any manual VIGIA_AGENT= setup.

All paths are overridable via environment variables so this can be unit
tested against a fake /proc and a fake agents directory (see
scripts/test-grok-bot-watch.py): VIGIA_PROC_ROOT, VIGIA_AGENTS_DIR,
VIGIA_TRANSCRIPTS_DIR, VIGIA_STATE_DIR, VIGIA_WATCH_LOG, VIGIA_HOOK,
VIGIA_POLL_INTERVAL, VIGIA_QUIET_SECONDS, VIGIA_RECENT_WINDOW.

Install/start with scripts/install-grok-bot-watch.sh (idempotent: a single
instance is kept alive via an flock on $VIGIA_STATE_DIR/watch.lock).
"""

import contextlib
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time

GENERIC_NAME = "Grok Bot"
STATE_FILE_NAMES = ("store.db", "store.db-wal", "audit.jsonl")

# Matches exactly one NUL-delimited /proc/<pid>/environ entry whose *name* is
# CURSOR_CONVERSATION_ID. Anchored at the start of the token on purpose: some
# sandbox-restore environment variables carry a whole shell snippet as their
# *value*, which can itself contain the literal substring
# "CURSOR_CONVERSATION_ID=" (e.g. a nested `builtin export
# CURSOR_CONVERSATION_ID=...`). An unanchored/substring search would pick
# that up and misattribute (or, worse, tempt a future caller into dumping
# the whole token -- which also carries unrelated secrets). Keep this
# anchored match, and never log or print a raw environ token.
_CONV_RE = re.compile(rb"^CURSOR_CONVERSATION_ID=(.*)$")


def _list_pids(proc_root):
    try:
        for name in os.listdir(proc_root):
            if name.isdigit():
                yield int(name)
    except OSError:
        return


def _read_ppid(proc_root, pid):
    try:
        with open(os.path.join(proc_root, str(pid), "stat"), "rb") as f:
            data = f.read()
        # cmdline ("comm") can contain spaces/parens; ppid is the field right
        # after the last ')'.
        end = data.rfind(b")")
        rest = data[end + 1 :].split()
        return int(rest[1])
    except (OSError, IndexError, ValueError):
        return None


def own_process_tree(proc_root, root_pid):
    """Return {root_pid} plus every descendant, so the watcher (and the
    curl/vigia-grok children it spawns) never attributes its own notifying
    activity back to itself as a "working" bot."""
    children = {}
    for pid in _list_pids(proc_root):
        ppid = _read_ppid(proc_root, pid)
        if ppid is not None:
            children.setdefault(ppid, []).append(pid)
    tree = set()
    stack = [root_pid]
    while stack:
        pid = stack.pop()
        if pid in tree:
            continue
        tree.add(pid)
        stack.extend(children.get(pid, []))
    return tree


def conversation_pids(proc_root, exclude_pids):
    """Map CURSOR_CONVERSATION_ID -> set of live pids carrying it, excluding
    exclude_pids entirely (not just from the count)."""
    result = {}
    for pid in _list_pids(proc_root):
        if pid in exclude_pids:
            continue
        try:
            with open(os.path.join(proc_root, str(pid), "environ"), "rb") as f:
                raw = f.read()
        except OSError:
            continue
        for token in raw.split(b"\0"):
            m = _CONV_RE.match(token)
            if m:
                conv_id = m.group(1).decode("utf-8", "replace")
                result.setdefault(conv_id, set()).add(pid)
                break
    return result


def live_active_conversations(proc_root, exclude_pids, min_pids=2):
    """A conversation is "live" when more than just its idle dispatcher
    shell is visible -- i.e. a command is actually running right now."""
    mapping = conversation_pids(proc_root, exclude_pids)
    return {conv for conv, pids in mapping.items() if len(pids) >= min_pids}


def _agent_latest_mtime(agents_dir, transcripts_dir, agent_id):
    best = None
    candidates = [os.path.join(agents_dir, agent_id, name) for name in STATE_FILE_NAMES]
    candidates.append(os.path.join(transcripts_dir, agent_id, f"{agent_id}.jsonl"))
    for path in candidates:
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            continue
        if best is None or mtime > best:
            best = mtime
    return best


def recent_agent_ids(agents_dir, transcripts_dir, agent_ids, window, now):
    """Agent ids whose state files changed in the last `window` seconds --
    a slow/secondary signal since these files only sync periodically."""
    recent = set()
    for agent_id in agent_ids:
        mtime = _agent_latest_mtime(agents_dir, transcripts_dir, agent_id)
        if mtime is not None and now - mtime < window:
            recent.add(agent_id)
    return recent


def _tail_bytes(path, n):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - n))
            return f.read()
    except OSError:
        return None


def _read_active_agent_id(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data.get("activeAgentId")
    except (OSError, ValueError):
        return None


class AgentNames:
    """Reads the .name field of every <agentId>/profile.json under
    agents_dir, re-reading a profile only when its mtime changes. Skips
    non-directory entries (active-agent.json, audit-outbox.json, ...)."""

    def __init__(self, agents_dir):
        self.agents_dir = agents_dir
        self._mtimes = {}
        self._names = {}

    def refresh(self):
        try:
            entries = os.listdir(self.agents_dir)
        except OSError:
            return
        seen = set()
        for entry in entries:
            path = os.path.join(self.agents_dir, entry)
            if not os.path.isdir(path):
                continue
            profile = os.path.join(path, "profile.json")
            try:
                mtime = os.stat(profile).st_mtime
            except OSError:
                continue
            seen.add(entry)
            if self._mtimes.get(entry) == mtime:
                continue
            name = None
            try:
                with open(profile, "r", encoding="utf-8") as f:
                    name = json.load(f).get("name")
            except (OSError, ValueError):
                pass
            if name:
                self._names[entry] = name
                self._mtimes[entry] = mtime
        for stale in set(self._names) - seen:
            del self._names[stale]
            self._mtimes.pop(stale, None)

    def ids(self):
        return set(self._names)

    def name_for(self, agent_id):
        return self._names.get(agent_id)


class Attributor:
    """Resolves a live conversation id to a bot name, following the
    fallback chain: direct agentId match -> an agent's own transcript
    mentions the conversation id -> the agent whose state files changed
    most recently -> active-agent.json -> generic "Grok Bot" name.

    Real resolutions are cached forever per conversation id (so a bot's
    attribution doesn't flap once known); the generic fallback is never
    cached, so attribution keeps improving as slow state syncs catch up.
    """

    def __init__(self, agents, agents_dir, transcripts_dir, active_agent_file,
                 transcript_recheck_seconds=60):
        self.agents = agents
        self.agents_dir = agents_dir
        self.transcripts_dir = transcripts_dir
        self.active_agent_file = active_agent_file
        self.transcript_recheck_seconds = transcript_recheck_seconds
        self._cache = {}
        self._transcript_checked = {}

    def resolve(self, conv_id, recent_ids, now):
        cached = self._cache.get(conv_id)
        if cached:
            return cached
        name = self._resolve_uncached(conv_id, recent_ids, now)
        if name:
            self._cache[conv_id] = name
            return name
        return GENERIC_NAME

    def _resolve_uncached(self, conv_id, recent_ids, now):
        direct = self.agents.name_for(conv_id)
        if direct:
            return direct

        last_checked = self._transcript_checked.get(conv_id, float("-inf"))
        if now - last_checked >= self.transcript_recheck_seconds:
            self._transcript_checked[conv_id] = now
            found = self._search_transcripts(conv_id)
            if found:
                return found

        if recent_ids:
            best_id, best_mtime = None, None
            for agent_id in recent_ids:
                mtime = _agent_latest_mtime(self.agents_dir, self.transcripts_dir, agent_id)
                if mtime is not None and (best_mtime is None or mtime > best_mtime):
                    best_id, best_mtime = agent_id, mtime
            if best_id:
                name = self.agents.name_for(best_id)
                if name:
                    return name

        active_id = _read_active_agent_id(self.active_agent_file)
        if active_id:
            name = self.agents.name_for(active_id)
            if name:
                return name
        return None

    def _search_transcripts(self, conv_id):
        needle = conv_id.encode("utf-8")
        for agent_id in self.agents.ids():
            path = os.path.join(self.transcripts_dir, agent_id, f"{agent_id}.jsonl")
            chunk = _tail_bytes(path, 65536)
            if chunk and needle in chunk:
                name = self.agents.name_for(agent_id)
                if name:
                    return name
        return None


class BotState:
    __slots__ = ("status", "last_active")

    def __init__(self):
        self.status = "idle"
        self.last_active = 0.0


def tick(states, working_names, now, hook, quiet_seconds):
    """One state-machine step. `hook(event, agent)` is called for
    transitions only: idle->working fires UserPromptSubmit immediately;
    working->idle fires Stop only after `quiet_seconds` with no signal."""
    for name in working_names:
        st = states.setdefault(name, BotState())
        if st.status != "working":
            hook("UserPromptSubmit", name)
            st.status = "working"
        st.last_active = now
    for name, st in states.items():
        if st.status == "working" and name not in working_names:
            if now - st.last_active >= quiet_seconds:
                hook("Stop", name)
                st.status = "idle"


class Config:
    def __init__(self):
        home = os.path.expanduser("~")
        self.agents_dir = os.environ.get("VIGIA_AGENTS_DIR", os.path.join(home, "agent-data", "agents"))
        default_transcripts = os.path.join(os.path.dirname(self.agents_dir.rstrip("/")), "agent-transcripts")
        self.transcripts_dir = os.environ.get("VIGIA_TRANSCRIPTS_DIR", default_transcripts)
        self.proc_root = os.environ.get("VIGIA_PROC_ROOT", "/proc")
        self.state_dir = os.environ.get("VIGIA_STATE_DIR", os.path.join(home, ".cache", "vigia"))
        self.log_file = os.environ.get("VIGIA_WATCH_LOG", "/tmp/vigia-grok-watch.log")
        self.hook = os.environ.get("VIGIA_HOOK", os.path.join(home, "bin", "vigia-grok"))
        self.poll_interval = float(os.environ.get("VIGIA_POLL_INTERVAL", "2"))
        self.quiet_seconds = float(os.environ.get("VIGIA_QUIET_SECONDS", "20"))
        self.recent_window = float(os.environ.get("VIGIA_RECENT_WINDOW", "60"))

    @property
    def active_agent_file(self):
        return os.path.join(self.agents_dir, "active-agent.json")


def _log(log_file, msg):
    try:
        with open(log_file, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')} {msg}\n")
    except OSError:
        pass


def _call_hook(hook_path, event, agent):
    env = dict(os.environ)
    env["VIGIA_AGENT"] = agent
    try:
        subprocess.Popen(
            [hook_path, event],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


def main():
    cfg = Config()
    os.makedirs(cfg.state_dir, exist_ok=True)

    lock_path = os.path.join(cfg.state_dir, "watch.lock")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        _log(cfg.log_file, "already-running exit")
        return 0

    pidfile = os.path.join(cfg.state_dir, "watch.pid")
    with open(pidfile, "w", encoding="utf-8") as f:
        f.write(str(os.getpid()))

    def _stop(signum, frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)

    _log(cfg.log_file, f"start pid={os.getpid()}")
    agents = AgentNames(cfg.agents_dir)
    attributor = Attributor(agents, cfg.agents_dir, cfg.transcripts_dir, cfg.active_agent_file)
    states = {}
    self_tree = own_process_tree(cfg.proc_root, os.getpid())
    self_tree_checked = time.time()

    try:
        while True:
            now = time.time()
            agents.refresh()
            if now - self_tree_checked > 10:
                self_tree = own_process_tree(cfg.proc_root, os.getpid())
                self_tree_checked = now

            agent_ids = agents.ids()
            recent_ids = recent_agent_ids(cfg.agents_dir, cfg.transcripts_dir, agent_ids,
                                           cfg.recent_window, now)
            live_convs = live_active_conversations(cfg.proc_root, self_tree)

            working_names = set()
            for conv_id in live_convs:
                working_names.add(attributor.resolve(conv_id, recent_ids, now))
            for agent_id in recent_ids:
                name = agents.name_for(agent_id)
                if name:
                    working_names.add(name)

            previously_working = {n for n, st in states.items() if st.status == "working"}

            def hook(event, agent):
                _call_hook(cfg.hook, event, agent)
                _log(cfg.log_file, f"{event} agent={agent}")

            tick(states, working_names, now, hook, cfg.quiet_seconds)

            now_working = {n for n, st in states.items() if st.status == "working"}
            if now_working != previously_working:
                _log(cfg.log_file, f"state working={sorted(now_working)}")

            time.sleep(cfg.poll_interval)
    except SystemExit:
        pass
    finally:
        _log(cfg.log_file, "stop")
        with contextlib.suppress(OSError):
            os.remove(pidfile)
        with contextlib.suppress(OSError):
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)
    return 0


if __name__ == "__main__":
    sys.exit(main())
